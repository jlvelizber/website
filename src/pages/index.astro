---
// Reemplaza cada .svg por tu imagen (.jpg / .webp) con el mismo nombre de archivo.
const services = [
  {
    title: 'Digitalización de procesos',
    text: 'Menos tareas manuales, más control sobre la operación diaria.',
  },
  {
    title: 'Sistemas empresariales',
    text: 'Plataformas internas adaptadas a cómo trabaja tu equipo.',
  },
  {
    title: 'Presencia digital',
    text: 'Sitios corporativos que comunican con claridad y generan confianza.',
  },
  {
    title: 'WordPress y e-commerce',
    text: 'Tiendas y sitios administrables, listos para crecer.',
  },
  {
    title: 'Apps web modernas',
    text: 'Experiencias dinámicas con React y Next.js.',
  },
  {
    title: 'Infraestructura y hosting',
    text: 'Servidores VPS Linux configurados, seguros y bajo control.',
  },
];

const industries = [
  { title: 'Clínicas y centros médicos', image: '/images/industries/clinicas.svg' },
  { title: 'Laboratorios', image: '/images/industries/laboratorios.svg' },
  { title: 'Instituciones educativas', image: '/images/industries/educacion.svg' },
  { title: 'Firmas de abogados', image: '/images/industries/abogados.svg' },
  { title: 'Empresas de servicios', image: '/images/industries/servicios.svg' },
  { title: 'Comercio electrónico', image: '/images/industries/ecommerce.svg' },
];

const projects = [
  {
    category: 'Salud',
    title: 'Portal web para centro médico',
    description: 'Sitio corporativo orientado a pacientes y servicios.',
    result: 'Mayor visibilidad y confianza digital',
    image: '/images/portfolio/proyecto-salud.svg',
  },
  {
    category: 'Sistemas empresariales',
    title: 'Plataforma de gestión interna',
    description: 'Sistema a medida para centralizar operaciones con Laravel.',
    result: 'Operaciones más ordenadas',
    image: '/images/portfolio/proyecto-sistema.svg',
  },
  {
    category: 'Comercio electrónico',
    title: 'Tienda online',
    description: 'E-commerce con catálogo, compra clara y panel de administración.',
    result: 'Canal de ventas operativo',
    image: '/images/portfolio/proyecto-ecommerce.svg',
  },
];

const technologies = [
  'PHP',
  'Laravel',
  'WordPress',
  'JavaScript',
  'React',
  'Next.js',
  'MySQL',
  'VPS Linux',
  'Hosting',
  'APIs',
];

const posts = [
  {
    title: 'Señales de que tu empresa necesita digitalizar procesos',
    image: '/images/blog/post-1.svg',
  },
  {
    title: 'Qué debe tener un sitio web corporativo en sectores regulados',
    image: '/images/blog/post-2.svg',
  },
  {
    title: 'Sistema a medida vs. WordPress: cuándo conviene cada uno',
    image: '/images/blog/post-3.svg',
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Jorge Veliz — Desarrollador Full Stack y consultor tecnológico. Aliado digital para empresas que buscan digitalizar procesos, mejorar su presencia web y optimizar operaciones."
    />
    <meta
      name="keywords"
      content="Jorge Veliz, consultor tecnológico, desarrollador full stack, digitalización empresarial, Laravel, WordPress, React, Next.js, VPS Linux"
    />
    <meta name="author" content="Jorge Veliz" />
    <meta property="og:title" content="Jorge Veliz | Consultor Tecnológico y Desarrollador Full Stack" />
    <meta
      property="og:description"
      content="Aliado tecnológico para empresas que quieren digitalizar procesos, fortalecer su presencia digital y operar con mayor eficiencia."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tudominio.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Jorge Veliz | Consultor Tecnológico y Desarrollador Full Stack</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#inicio" aria-label="Ir al inicio">
        <span class="brand-mark">JV</span>
        <span>Jorge Veliz</span>
      </a>
      <nav class="nav" aria-label="Navegación principal">
        <a href="#sobre-mi">Sobre mí</a>
        <a href="#servicios">Servicios</a>
        <a href="#industrias">Industrias</a>
        <a href="#portafolio">Portafolio</a>
        <a href="#blog">Blog</a>
        <a class="nav-cta" href="#contacto">Conversar</a>
      </nav>
    </header>

    <main id="inicio">
      <section class="hero section">
        <div class="hero-content">
          <p class="eyebrow">Consultoría tecnológica · Full Stack</p>
          <h1>Tu aliado tecnológico para digitalizar procesos y hacer crecer tu empresa.</h1>
          <p class="hero-copy">
            Ayudo a empresas a ordenar operaciones, fortalecer su presencia digital y contar con
            infraestructura confiable.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="#contacto">Conversar sobre tu proyecto</a>
            <a class="button secondary" href="#portafolio">Ver experiencia</a>
          </div>
          <div class="trust-bar" aria-label="Especialidades principales">
            <span>Laravel</span>
            <span>WordPress</span>
            <span>React</span>
            <span>Next.js</span>
            <span>VPS Linux</span>
          </div>
        </div>
        <figure class="hero-media">
          <!-- Reemplazar src por /images/hero.jpg -->
          <img
            class="media-img media-img--hero"
            src="/images/hero.svg"
            alt="Jorge Veliz — consultor tecnológico"
            width="1200"
            height="900"
            loading="eager"
          />
        </figure>
      </section>

      <section class="section logos" aria-label="Propuesta de valor">
        <span>Digitalización</span>
        <span>Presencia digital</span>
        <span>Operaciones</span>
        <span>Infraestructura</span>
        <span>Consultoría</span>
      </section>

      <section id="sobre-mi" class="section split split--center">
        <figure class="about-media">
          <!-- Reemplazar src por /images/about.jpg -->
          <img
            class="media-img media-img--portrait"
            src="/images/about.svg"
            alt="Jorge Veliz"
            width="800"
            height="1000"
            loading="lazy"
          />
        </figure>
        <div class="rich-text">
          <p class="eyebrow">Sobre mí</p>
          <h2>Experiencia técnica con enfoque en negocio.</h2>
          <p>
            Soy Jorge Veliz, desarrollador Full Stack y consultor tecnológico. He trabajado con
            clínicas, laboratorios, instituciones educativas, firmas de abogados, empresas de
            servicios y comercio electrónico.
          </p>
          <p>
            Primero entiendo tu operación; después propongo y construyo la solución que tenga sentido
            para tu contexto.
          </p>
        </div>
      </section>

      <section id="servicios" class="section">
        <div class="section-heading section-heading--compact">
          <p class="eyebrow">Servicios</p>
          <h2>Soluciones para operar mejor y crecer con confianza.</h2>
        </div>
        <div class="card-grid">
          {services.map((service) => (
            <article class="service-card">
              <h3>{service.title}</h3>
              <p>{service.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="industrias" class="section">
        <div class="section-heading section-heading--compact">
          <p class="eyebrow">Industrias</p>
          <h2>Sectores donde he acompañado empresas.</h2>
        </div>
        <div class="industry-grid">
          {industries.map((industry) => (
            <article class="industry-card">
              <img
                class="media-img media-img--thumb"
                src={industry.image}
                alt={industry.title}
                width="400"
                height="280"
                loading="lazy"
              />
              <h3>{industry.title}</h3>
            </article>
          ))}
        </div>
      </section>

      <section id="portafolio" class="section dark-section">
        <div class="section-heading section-heading--compact">
          <p class="eyebrow">Portafolio</p>
          <h2>Proyectos representativos.</h2>
        </div>
        <div class="project-grid">
          {projects.map((project) => (
            <article class="project-card">
              <img
                class="media-img media-img--project"
                src={project.image}
                alt={project.title}
                width="800"
                height="500"
                loading="lazy"
              />
              <div class="project-body">
                <span>{project.category}</span>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                <strong>{project.result}</strong>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="tecnologias" class="section split split--center">
        <div>
          <p class="eyebrow">Tecnologías</p>
          <h2>Herramientas según lo que tu proyecto necesita.</h2>
        </div>
        <div class="tech-list">
          {technologies.map((tech) => <span>{tech}</span>)}
        </div>
      </section>

      <section id="blog" class="section">
        <div class="section-heading section-heading--compact">
          <p class="eyebrow">Blog</p>
          <h2>Tecnología aplicada al negocio.</h2>
        </div>
        <div class="blog-grid">
          {posts.map((post) => (
            <article class="blog-card">
              <img
                class="media-img media-img--blog"
                src={post.image}
                alt=""
                width="600"
                height="340"
                loading="lazy"
              />
              <div class="blog-body">
                <h3>{post.title}</h3>
                <a href="#contacto">Hablemos de esto</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section cta-panel">
        <div>
          <p class="eyebrow">Próximo paso</p>
          <h2>¿Listo para ordenar procesos o mejorar tu presencia digital?</h2>
        </div>
        <a class="button primary" href="#contacto">Agendar una conversación</a>
      </section>

      <section id="contacto" class="section contact">
        <div>
          <p class="eyebrow">Contacto</p>
          <h2>Cuéntame qué necesita tu empresa.</h2>
          <p>Te responderé con alcance, enfoque recomendado y próximos pasos.</p>
        </div>
        <form class="contact-form" name="contacto" method="post">
          <label>
            Nombre
            <input type="text" name="nombre" placeholder="Tu nombre" required />
          </label>
          <label>
            Email
            <input type="email" name="email" placeholder="tu@email.com" required />
          </label>
          <label>
            Tipo de proyecto
            <select name="tipo" required>
              <option value="">Selecciona una opción</option>
              <option>Digitalización de procesos</option>
              <option>Sistema empresarial a medida</option>
              <option>Sitio web corporativo</option>
              <option>WordPress / comercio electrónico</option>
              <option>Aplicación web (React / Next.js)</option>
              <option>Infraestructura / hosting / VPS</option>
              <option>Consultoría tecnológica</option>
            </select>
          </label>
          <label>
            Mensaje
            <textarea name="mensaje" rows="5" placeholder="Describe brevemente qué necesitas resolver o mejorar" required></textarea>
          </label>
          <button class="button primary" type="submit">Enviar mensaje</button>
          <p class="form-note">Responderé a tu solicitud en un plazo razonable.</p>
        </form>
      </section>
    </main>

    <footer class="footer">
      <p>© 2026 Jorge Veliz. Consultoría tecnológica, desarrollo Full Stack e infraestructura digital.</p>
      <a href="#inicio">Volver arriba</a>
    </footer>
  </body>
</html>

<style>
  :root {
    --bg: #f6f8fb;
    --surface: #ffffff;
    --ink: #0f172a;
    --muted: #5b6475;
    --line: #dce3ee;
    --primary: #2563eb;
    --primary-dark: #1744a7;
    --accent: #14b8a6;
    --dark: #08111f;
    --dark-soft: #111c2e;
    --radius: 24px;
    --shadow: 0 24px 80px rgba(15, 23, 42, 0.12);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background:
      radial-gradient(circle at top left, rgba(37, 99, 235, 0.12), transparent 34rem),
      linear-gradient(180deg, #ffffff 0%, var(--bg) 45%, #ffffff 100%);
    color: var(--ink);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    line-height: 1.6;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(1180px, calc(100% - 32px));
    margin: 16px auto 0;
    padding: 14px 16px;
    border: 1px solid rgba(220, 227, 238, 0.88);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.84);
    box-shadow: 0 16px 60px rgba(15, 23, 42, 0.08);
    backdrop-filter: blur(18px);
  }

  .brand,
  .nav,
  .hero-actions,
  .trust-bar,
  .logos,
  .cta-panel,
  .footer {
    display: flex;
    align-items: center;
  }

  .brand {
    gap: 0.7rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .brand-mark {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border-radius: 50%;
    background: var(--ink);
    color: #ffffff;
    font-size: 0.85rem;
  }

  .nav {
    gap: 1.2rem;
    color: var(--muted);
    font-size: 0.94rem;
    font-weight: 650;
  }

  .nav a:hover {
    color: var(--primary);
  }

  .nav-cta {
    padding: 0.75rem 1rem;
    border-radius: 999px;
    background: var(--ink);
    color: #ffffff !important;
  }

  .section {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 92px 0;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
    gap: 2rem;
    align-items: center;
    min-height: auto;
    padding-top: 48px;
  }

  .media-img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--line);
  }

  .media-img--hero {
    aspect-ratio: 4 / 3;
    box-shadow: var(--shadow);
  }

  .media-img--portrait {
    aspect-ratio: 4 / 5;
    box-shadow: 0 12px 40px rgba(15, 23, 42, 0.1);
  }

  .media-img--thumb {
    aspect-ratio: 10 / 7;
    border-radius: 18px;
    margin-bottom: 0.85rem;
  }

  .media-img--project {
    aspect-ratio: 16 / 10;
    border-radius: 18px 18px 0 0;
  }

  .media-img--blog {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius) var(--radius) 0 0;
  }

  .hero-media,
  .about-media {
    margin: 0;
  }

  .split--center {
    align-items: center;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--primary);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 820px;
    margin-bottom: 1.4rem;
    font-size: clamp(2.9rem, 7vw, 5.9rem);
    line-height: 0.95;
    letter-spacing: -0.07em;
  }

  h2 {
    margin-bottom: 1rem;
    font-size: clamp(2rem, 4vw, 3.45rem);
    line-height: 1.02;
    letter-spacing: -0.055em;
  }

  h3 {
    margin-bottom: 0.8rem;
    font-size: 1.18rem;
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .hero-copy,
  .section-heading p,
  .section-copy,
  .rich-text,
  .contact p {
    color: var(--muted);
    font-size: 1.08rem;
  }

  .hero-copy {
    max-width: 700px;
    margin-bottom: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.9rem 1.25rem;
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      background 180ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button.primary {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: #ffffff;
    box-shadow: 0 18px 40px rgba(37, 99, 235, 0.28);
  }

  .button.secondary {
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
  }

  .hero-actions {
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 2rem;
  }

  .trust-bar {
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .trust-bar span,
  .tech-list span,
  .logos span {
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.76);
    color: var(--muted);
    font-size: 0.88rem;
    font-weight: 750;
  }

  .trust-bar span {
    padding: 0.52rem 0.85rem;
  }

  .logos {
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0 0 54px;
  }

  .logos span {
    flex: 1;
    padding: 1rem;
    text-align: center;
  }

  .split {
    display: grid;
    grid-template-columns: 0.78fr 1.22fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .rich-text p:last-child,
  .section-heading p:last-child,
  .section-copy:last-child {
    margin-bottom: 0;
  }

  .section-heading {
    max-width: 760px;
    margin-bottom: 2rem;
  }

  .section-heading--compact {
    margin-bottom: 1.5rem;
  }

  .section-heading--compact h2 {
    margin-bottom: 0;
  }

  .industry-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .industry-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.82);
    padding: 0.85rem 0.85rem 1.1rem;
    box-shadow: 0 12px 40px rgba(15, 23, 42, 0.05);
  }

  .industry-card h3 {
    margin: 0;
    font-size: 1rem;
  }

  .card-grid,
  .project-grid,
  .blog-grid {
    display: grid;
    gap: 1rem;
  }

  .card-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .service-card,
  .blog-card,
  .contact-form {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 12px 40px rgba(15, 23, 42, 0.05);
  }

  .service-card,
  .blog-card {
    padding: 1.25rem;
  }

  .blog-card {
    overflow: hidden;
    padding: 0;
  }

  .blog-body {
    padding: 1.25rem;
  }

  .blog-body h3 {
    margin-bottom: 0.75rem;
  }

  .service-card p,
  .blog-card p,
  .project-card p {
    color: var(--muted);
  }

  .blog-card > p {
    display: none;
  }

  .dark-section {
    width: min(1220px, calc(100% - 24px));
    padding: 80px clamp(16px, 4vw, 40px);
    border-radius: 36px;
    background:
      radial-gradient(circle at top right, rgba(20, 184, 166, 0.22), transparent 30rem),
      var(--dark);
    color: #ffffff;
  }

  .dark-section .section-heading p,
  .project-card p {
    color: #b9c3d6;
  }

  .project-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .project-card {
    overflow: hidden;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.06);
  }

  .project-body {
    padding: 1.25rem;
  }

  .project-card span {
    display: inline-flex;
    margin-bottom: 0.65rem;
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .project-card strong {
    color: #ffffff;
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-content: start;
  }

  .tech-list span {
    padding: 0.72rem 1rem;
  }

  .blog-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .blog-card a {
    color: var(--primary);
    font-weight: 800;
    font-size: 0.94rem;
  }

  .cta-panel {
    justify-content: space-between;
    gap: 2rem;
    padding: 2rem;
    border-radius: 32px;
    background: linear-gradient(135deg, #eef4ff, #ffffff);
    box-shadow: 0 18px 60px rgba(15, 23, 42, 0.08);
  }

  .cta-panel h2 {
    max-width: 760px;
    margin-bottom: 0;
  }

  .contact {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 2rem;
    align-items: start;
  }

  .contact-form {
    display: grid;
    gap: 1rem;
    padding: 1.4rem;
  }

  label {
    display: grid;
    gap: 0.45rem;
    color: var(--ink);
    font-weight: 800;
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: #ffffff;
    color: var(--ink);
    font: inherit;
    padding: 0.95rem 1rem;
    outline: none;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
  }

  textarea {
    resize: vertical;
  }

  .form-note {
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .footer {
    justify-content: space-between;
    gap: 1rem;
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 2rem 0 3rem;
