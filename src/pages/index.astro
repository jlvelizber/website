---
// Reemplaza cada .svg por tu imagen (.jpg / .webp) o actualiza la ruta aquí.
const services = [
  {
    title: 'Digitalización de procesos',
    text: 'Menos tareas manuales, más control sobre la operación diaria.',
  },
  {
    title: 'Sistemas empresariales',
    text: 'Plataformas internas adaptadas a cómo trabaja tu equipo.',
  },
  {
    title: 'Presencia digital',
    text: 'Sitios corporativos que comunican con claridad y generan confianza.',
  },
  {
    title: 'WordPress y e-commerce',
    text: 'Tiendas y sitios administrables, listos para crecer.',
  },
  {
    title: 'Apps web modernas',
    text: 'Experiencias dinámicas con React y Next.js.',
  },
  {
    title: 'Infraestructura y hosting',
    text: 'Servidores VPS Linux configurados, seguros y bajo control.',
  },
];

const industries = [
  { title: 'Clínicas y centros médicos', image: '/images/industries/clinicas.svg' },
  { title: 'Laboratorios', image: '/images/industries/laboratorios.svg' },
  { title: 'Instituciones educativas', image: '/images/industries/educacion.svg' },
  { title: 'Firmas de abogados', image: '/images/industries/abogados.svg' },
  { title: 'Empresas de servicios', image: '/images/industries/servicios.svg' },
  { title: 'Comercio electrónico', image: '/images/industries/ecommerce.svg' },
];

const projects = [
  {
    filter: 'salud',
    category: 'Salud',
    title: 'Portal web para centro médico',
    description: 'Sitio corporativo orientado a pacientes y servicios.',
    result: 'Mayor visibilidad y confianza digital',
    image: '/images/portfolio/proyecto-salud.svg',
  },
  {
    filter: 'sistemas',
    category: 'Sistemas',
    title: 'Plataforma de gestión interna',
    description: 'Sistema a medida para centralizar operaciones con Laravel.',
    result: 'Operaciones más ordenadas',
    image: '/images/portfolio/proyecto-sistema.svg',
  },
  {
    filter: 'ecommerce',
    category: 'E-commerce',
    title: 'Tienda online',
    description: 'Catálogo, compra clara y panel de administración.',
    result: 'Canal de ventas operativo',
    image: '/images/portfolio/proyecto-ecommerce.svg',
  },
];

const filters = [
  { id: 'all', label: 'Todos' },
  { id: 'salud', label: 'Salud' },
  { id: 'sistemas', label: 'Sistemas' },
  { id: 'ecommerce', label: 'E-commerce' },
];

const technologies = [
  'JAVA',
  'JavaScript',
  'PHP',
  'Spring Boot',
  'Laravel',
  'WordPress',
  'React',
  'Next.js',
  'Bases de datos',
  'APIs',
  'VPS Linux',
  'Hosting',
];

const posts = [
  {
    title: 'Señales de que tu empresa necesita digitalizar procesos',
    tag: 'Operaciones',
    image: '/images/blog/post-1.svg',
  },
  {
    title: 'Qué debe tener un sitio web corporativo en sectores regulados',
    tag: 'Presencia digital',
    image: '/images/blog/post-2.svg',
  },
  {
    title: 'Sistema a medida vs. WordPress: cuándo conviene cada uno',
    tag: 'Tecnología',
    image: '/images/blog/post-3.svg',
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Jorge Veliz — Desarrollador Full Stack y consultor tecnológico. Aliado digital para empresas que buscan digitalizar procesos, mejorar su presencia web y optimizar operaciones."
    />
    <meta
      name="keywords"
      content="Jorge Veliz, consultor tecnológico, desarrollador full stack, digitalización empresarial, Laravel, WordPress, React, Next.js, VPS Linux"
    />
    <meta name="author" content="Jorge Veliz" />
    <meta property="og:title" content="Jorge Veliz | Consultor Tecnológico y Desarrollador Full Stack" />
    <meta
      property="og:description"
      content="Aliado tecnológico para empresas que quieren digitalizar procesos, fortalecer su presencia digital y operar con mayor eficiencia."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tudominio.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>Jorge Veliz | Consultor Tecnológico y Desarrollador Full Stack</title>
  </head>
  <body>
    <!-- 1. Header: logo | nav | CTA -->
    <header class="site-header">
      <div class="container header-row">
        <a class="brand" href="#inicio" aria-label="Ir al inicio">
          <!-- <span class="brand-mark">JV</span>
          <span class="brand-text">
            <strong>Jorge Veliz</strong>
            <small>Consultor tecnológico</small>
          </span> -->
          <img src="/images/logo-jorge-veliz.png" alt="Jorge Veliz" width="55%" />
          <!-- <span class="brand-text">
            <strong>Jorge Veliz</strong>
            <small>Consultor tecnológico</small>
          </span>  -->
        </a>
        <nav class="nav" aria-label="Navegación principal">
          <a href="#inicio">Inicio</a>
          <a href="#sobre-mi">Sobre mí</a>
          <a href="#servicios">Servicios</a>
          <a href="#portafolio">Portafolio</a>
          <a href="#blog">Blog</a>
          <a href="#contacto">Contacto</a>
        </nav>
        <a class="button dark" href="#contacto">Conversar</a>
      </div>
    </header>

    <main id="inicio">
      <!-- 2. Hero: copy izquierda + retrato derecha -->
      <section class="hero">
        <div class="container hero-row">
          <div class="hero-copy">
            <p class="welcome">Bienvenido a mi portafolio</p>
            <h1>
              Soy Jorge Veliz
              <span class="role">Full Stack &amp; consultor</span>
            </h1>
            <p class="lead">
              Ayudo a empresas a digitalizar procesos, fortalecer su presencia digital y operar con
              infraestructura confiable.
            </p>
            <div class="hero-cta">
              <a class="button primary" href="#contacto">Hablemos</a>
              <div class="hero-note">
                <span>Enfoque</span>
                <strong>Digitalización empresarial</strong>
              </div>
            </div>
          </div>
          <div class="hero-visual">
            <div class="hero-orb" aria-hidden="true"></div>
            <figure class="hero-photo">
              <img
                src="/images/hero-jorge-veliz.jpg"
                alt="Jorge Veliz — consultor tecnológico"
                width="800"
                height="800"
                loading="eager"
              />
            </figure>
          </div>
        </div>
        <div class="container head-links">
          <a href="#contacto">Escríbeme para una consulta</a>
          <a href="#portafolio">Ver proyectos representativos</a>
        </div>
      </section>

      <!-- 3. About: bio + tarjetas de datos -->
      <section id="sobre-mi" class="section about">
        <div class="container about-row">
          <div class="about-copy">
            <h2>Sobre mí</h2>
            <p>
              Soy desarrollador Full Stack y consultor tecnológico. He trabajado  sistemas empresariales y financieros, clínicas,
              laboratorios, instituciones educativas, firmas de abogados, empresas de servicios y comercio electrónico.
            </p>
            <div class="tech-pills">
              {technologies.slice(0, 6).map((tech) => <span>{tech}</span>)}
            </div>
          </div>
          <aside class="about-cards">
            <div class="info-card">
              <div>
                <span>Nombre</span>
                <strong>Jorge Veliz</strong>
              </div>
            </div>
            <div class="info-card">
              <div>
                <span>Enfoque</span>
                <strong>Consultoría tecnológica</strong>
              </div>
            </div>
            <div class="info-card">
              <div>
                <span>Disponibilidad</span>
                <strong>Nuevos proyectos</strong>
              </div>
            </div>
          </aside>
        </div>
      </section>

      <!-- 4. Services: heading centrado + grid -->
      <section id="servicios" class="section services">
        <div class="container">
          <div class="section-head center">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span> Servicios</p>
            <h2>Servicios esenciales</h2>
          </div>
          <div class="service-grid">
            {services.map((service) => (
              <article class="service-card">
                <h3>{service.title}</h3>
                <p>{service.text}</p>
                <a href="#contacto">Consultar</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- 5. Portfolio: filtros + proyectos -->
      <section id="portafolio" class="section portfolio">
        <div class="container">
          <div class="section-head center">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span> Portafolio</p>
            <h2>Casos y proyectos</h2>
          </div>
          <div class="filters" role="tablist" aria-label="Filtrar proyectos">
            {filters.map((filter, index) => (
              <button
                type="button"
                class:list={['filter-btn', { active: index === 0 }]}
                data-filter={filter.id}
              >
                {filter.label}
              </button>
            ))}
          </div>
          <div class="project-grid">
            {projects.map((project) => (
              <article class="project-card" data-category={project.filter}>
                <img
                  src={project.image}
                  alt={project.title}
                  width="800"
                  height="500"
                  loading="lazy"
                />
                <div class="project-body">
                  <span>{project.category}</span>
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                  <strong>{project.result}</strong>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- 6. Industrias (bloque propio, no testimonios inventados) -->
      <section id="industrias" class="section industries">
        <div class="container">
          <div class="section-head center">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span> Industrias</p>
            <h2>Sectores donde he acompañado empresas</h2>
          </div>
          <div class="industry-grid">
            {industries.map((industry) => (
              <article class="industry-card">
                <img src={industry.image} alt="" width="400" height="280" loading="lazy" />
                <h3>{industry.title}</h3>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- 7. Contact CTA: info + form -->
      <section id="contacto" class="section contact">
        <div class="container contact-row">
          <div class="contact-info">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span> Contacto</p>
            <h2>¿Tienes un proyecto en mente?</h2>
            <p>
              Cuéntame qué necesitas digitalizar, mejorar o estabilizar. Te respondo con alcance y
              próximos pasos.
            </p>
            <ul class="contact-list">
              <li><strong>Enfoque:</strong> Digitalización, sistemas y presencia digital</li>
              <li><strong>Stack:</strong> Laravel, WordPress, React, Next.js, VPS</li>
              <li><strong>Respuesta:</strong> En un plazo razonable</li>
            </ul>
          </div>
          <form class="contact-form" name="contacto" method="post">
            <label>
              Nombre
              <input type="text" name="nombre" placeholder="Tu nombre" required />
            </label>
            <label>
              Email
              <input type="email" name="email" placeholder="tu@email.com" required />
            </label>
            <label>
              Tipo de proyecto
              <select name="tipo" required>
                <option value="">Selecciona una opción</option>
                <option>Digitalización de procesos</option>
                <option>Sistema empresarial a medida</option>
                <option>Sitio web corporativo</option>
                <option>WordPress / comercio electrónico</option>
                <option>Aplicación web (React / Next.js)</option>
                <option>Infraestructura / hosting / VPS</option>
                <option>Consultoría tecnológica</option>
              </select>
            </label>
            <label>
              Mensaje
              <textarea
                name="mensaje"
                rows="4"
                placeholder="Describe brevemente qué necesitas resolver"
                required
              ></textarea>
            </label>
            <button class="button primary" type="submit">Enviar solicitud</button>
          </form>
        </div>
      </section>

      <!-- 8. Blog -->
      <section id="blog" class="section blog">
        <div class="container">
          <div class="section-head center">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span> Blog</p>
            <h2>Ideas y reflexiones</h2>
          </div>
          <div class="blog-grid">
            {posts.map((post) => (
              <article class="blog-card">
                <img src={post.image} alt="" width="600" height="340" loading="lazy" />
                <div class="blog-body">
                  <span>{post.tag}</span>
                  <h3>{post.title}</h3>
                  <a href="#contacto">Hablemos de esto</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- 9. Footer chat banner -->
      <section class="chat-banner">
        <div class="container chat-row">
          <div>
            <h2>¿Conversamos?</h2>
            <p>
              Si tienes un proyecto o quieres explorar cómo digitalizar procesos en tu empresa,
              escríbeme.
            </p>
          </div>
          <a class="button primary" href="#contacto">Ir a contacto</a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer-row">
        <p>© 2026 Jorge Veliz. Consultoría tecnológica · Full Stack · Infraestructura</p>
        <a href="#inicio">Volver arriba</a>
      </div>
    </footer>

    <script>
      const buttons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.project-card');

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');
          buttons.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          cards.forEach((card) => {
            const cat = card.getAttribute('data-category');
            card.hidden = !(filter === 'all' || cat === filter);
          });
        });
      });
    </script>
  </body>
</html>

<style>
  /* Paleta original del sitio (no Iteck) */
  :root {
    --bg: #f6f8fb;
    --surface: #ffffff;
    --ink: #0f172a;
    --muted: #5b6475;
    --line: #dce3ee;
    --primary: #2563eb;
    --primary-dark: #1744a7;
    --accent: #14b8a6;
    --dark: #08111f;
    --radius: 20px;
    --shadow: 0 16px 50px rgba(15, 23, 42, 0.08);
    --font: 'Plus Jakarta Sans', ui-sans-serif, system-ui, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    color: var(--ink);
    background: var(--bg);
    font-family: var(--font);
    line-height: 1.65;
  }

  img {
    display: block;
    max-width: 100%;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2,
  h3 {
    letter-spacing: -0.03em;
    line-height: 1.12;
    font-weight: 800;
  }

  .container {
    width: min(1140px, calc(100% - 32px));
    margin: 0 auto;
  }

  /* ——— Header ——— */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(246, 248, 251, 0.92);
    backdrop-filter: blur(12px);
  }

  .header-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 16px 0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--ink);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 800;
  }

  .brand-text {
    display: grid;
  }

  .brand-text strong {
    font-size: 1.05rem;
  }

  .brand-text small {
    color: var(--muted);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .nav {
    display: flex;
    gap: 1.3rem;
    font-size: 0.94rem;
    font-weight: 600;
    color: var(--muted);
  }

  .nav a:hover {
    color: var(--primary);
  }

  .header-row .button {
    justify-self: end;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0.7rem 1.25rem;
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: transform 160ms ease, background 160ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button.primary {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: #fff;
    box-shadow: 0 14px 30px rgba(37, 99, 235, 0.25);
  }

  .button.dark {
    background: var(--ink);
    color: #fff;
  }

  /* ——— Hero skeleton ——— */
  .hero {
    padding: 28px 0 0;
  }

  .hero-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
    min-height: 72vh;
  }

  .welcome {
    margin: 0 0 0.9rem;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin-bottom: 1rem;
    font-size: clamp(2.6rem, 6vw, 4.2rem);
  }

  .role {
    display: block;
    color: var(--primary);
  }

  .lead {
    max-width: 36rem;
    margin-bottom: 1.6rem;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.1rem;
  }

  .hero-note span {
    display: block;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .hero-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 0;
    width: 100%;
  }

  .hero-orb {
    position: absolute;
    right: 2%;
    bottom: 2%;
    width: min(360px, 78%);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, #60a5fa, var(--primary));
  }

  .hero-photo {
    position: relative;
    z-index: 1;
    margin: 0;
    width: min(480px, 100%);
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 12%;
  }

  .head-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 1.25rem 0 2rem;
    color: var(--muted);
    font-weight: 600;
  }

  .head-links a:hover {
    color: var(--primary);
  }

  /* ——— Sections ——— */
  .section {
    padding: 88px 0;
  }

  .section-head {
    margin-bottom: 2rem;
  }

  .section-head.center {
    text-align: center;
  }

  .eyebrow {
    position: relative;
    display: inline-block;
    margin: 0 0 0.7rem;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .eyebrow .dot {
    position: absolute;
    left: -0.35rem;
    top: 50%;
    width: 22px;
    height: 22px;
    margin-top: -11px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.35;
    z-index: -1;
  }

  h2 {
    margin-bottom: 0.6rem;
    font-size: clamp(1.9rem, 3.4vw, 2.7rem);
  }

  h3 {
    margin-bottom: 0.55rem;
    font-size: 1.1rem;
  }

  /* About */
  .about {
    background: var(--surface);
    border-radius: 32px 32px 0 0;
  }

  .about-row {
    display: grid;
    grid-template-columns: 1.25fr 0.85fr;
    gap: 2.5rem;
    align-items: start;
  }

  .about-copy p {
    color: var(--muted);
    max-width: 52ch;
  }

  .tech-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.4rem;
  }

  .tech-pills span {
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid var(--line);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .about-cards {
    display: grid;
    gap: 0.8rem;
  }

  .info-card {
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #fff;
    box-shadow: var(--shadow);
  }

  .info-card span {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--muted);
    font-size: 0.78rem;
  }

  /* Services */
  .services {
    background: #eef2f7;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .service-card {
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .service-card p {
    color: var(--muted);
    min-height: 3.2em;
  }

  .service-card a {
    color: var(--primary);
    font-weight: 700;
    font-size: 0.9rem;
  }

  /* Portfolio */
  .filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.55rem;
    margin-bottom: 1.8rem;
  }

  .filter-btn {
    min-height: 40px;
    padding: 0.5rem 1.05rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fff;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    color: var(--ink);
  }

  .filter-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: #fff;
  }

  .project-grid {
    display: grid;
