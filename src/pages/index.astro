---
const services = [
  {
    title: 'Digitalización de procesos',
    text: 'Identifico tareas repetitivas, cuellos de botella y flujos manuales para convertirlos en sistemas que ahorran tiempo y reducen errores en el día a día de tu empresa.',
  },
  {
    title: 'Sistemas empresariales a medida',
    text: 'Desarrollo plataformas internas, paneles de gestión y herramientas adaptadas a cómo opera tu negocio, con información centralizada y accesible para tu equipo.',
  },
  {
    title: 'Presencia digital y sitios web',
    text: 'Sitios corporativos, portales informativos y plataformas que comunican con claridad lo que hace tu empresa y facilitan que clientes y prospectos den el siguiente paso.',
  },
  {
    title: 'WordPress y comercio electrónico',
    text: 'Tiendas online y sitios administrables que tu equipo puede actualizar sin depender siempre de un técnico, con una base sólida para crecer.',
  },
  {
    title: 'Aplicaciones web modernas',
    text: 'Interfaces dinámicas y experiencias digitales construidas con React y Next.js, pensadas para usuarios exigentes y procesos que evolucionan con tu negocio.',
  },
  {
    title: 'Infraestructura, hosting y servidores',
    text: 'Configuración, migración y administración de servidores VPS Linux para que tu plataforma esté disponible, segura y preparada para el crecimiento.',
  },
];

const industries = [
  {
    title: 'Clínicas y centros médicos',
    text: 'Sitios informativos, gestión de citas, portales para pacientes y herramientas que mejoran la comunicación entre el centro y quienes confían en su atención.',
  },
  {
    title: 'Laboratorios',
    text: 'Plataformas que organizan información, facilitan consultas y fortalecen la imagen profesional de laboratorios que necesitan presencia digital confiable.',
  },
  {
    title: 'Instituciones educativas',
    text: 'Portales institucionales, aulas virtuales y sistemas que conectan administración, docentes y estudiantes en un entorno digital ordenado.',
  },
  {
    title: 'Firmas de abogados',
    text: 'Sitios corporativos y herramientas internas que proyectan seriedad, organizan información sensible y apoyan la operación diaria del despacho.',
  },
  {
    title: 'Empresas de servicios',
    text: 'Presencia digital, sistemas de gestión y automatización de procesos para empresas que quieren operar con mayor eficiencia y mejor servicio al cliente.',
  },
  {
    title: 'Comercio electrónico',
    text: 'Tiendas online y plataformas de venta diseñadas para presentar productos con claridad, facilitar la compra y sostener el crecimiento del negocio.',
  },
];

const projects = [
  {
    category: 'Salud',
    title: 'Portal web para centro médico',
    description:
      'Sitio corporativo con información de servicios, canales de contacto y estructura pensada para que pacientes encuentren lo que necesitan con rapidez.',
    result: 'Mayor visibilidad y confianza digital',
  },
  {
    category: 'Sistemas empresariales',
    title: 'Plataforma de gestión interna',
    description:
      'Sistema a medida con Laravel para centralizar operaciones, reducir tareas manuales y dar al equipo una herramienta alineada con sus procesos reales.',
    result: 'Operaciones más ordenadas y controladas',
  },
  {
    category: 'Educación',
    title: 'Plataforma digital para institución educativa',
    description:
      'Entorno web para comunicación institucional, gestión de contenidos y apoyo a la formación, con una base técnica estable y fácil de administrar.',
    result: 'Comunicación y gestión en un solo lugar',
  },
  {
    category: 'Comercio electrónico',
    title: 'Tienda online sobre WordPress',
    description:
      'E-commerce con catálogo de productos, proceso de compra claro y panel de administración para que el negocio gestione su operación digital con autonomía.',
    result: 'Canal de ventas digital operativo',
  },
  {
    category: 'Servicios profesionales',
    title: 'Sitio corporativo para firma de abogados',
    description:
      'Presencia web que transmite profesionalismo, presenta áreas de práctica y facilita el contacto con clientes potenciales.',
    result: 'Imagen sólida y presencia profesional',
  },
  {
    category: 'Infraestructura',
    title: 'Migración y administración de servidores',
    description:
      'Traslado de plataformas a entorno VPS Linux, configuración de hosting, respaldos y monitoreo para garantizar estabilidad y continuidad operativa.',
    result: 'Infraestructura confiable y bajo control',
  },
];

const technologies = [
  'PHP',
  'Laravel',
  'WordPress',
  'JavaScript',
  'React',
  'Next.js',
  'MySQL',
  'VPS Linux',
  'Hosting',
  'APIs',
];

const posts = [
  'Señales de que tu empresa necesita digitalizar procesos antes de que el caos operativo crezca',
  'Qué debe tener un sitio web corporativo para generar confianza en sectores regulados',
  'Cuándo conviene un sistema a medida y cuándo una plataforma como WordPress',
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Jorge Veliz — Desarrollador Full Stack y consultor tecnológico. Aliado digital para empresas que buscan digitalizar procesos, mejorar su presencia web y optimizar operaciones."
    />
    <meta
      name="keywords"
      content="Jorge Veliz, consultor tecnológico, desarrollador full stack, digitalización empresarial, Laravel, WordPress, React, Next.js, VPS Linux"
    />
    <meta name="author" content="Jorge Veliz" />
    <meta property="og:title" content="Jorge Veliz | Consultor Tecnológico y Desarrollador Full Stack" />
    <meta
      property="og:description"
      content="Aliado tecnológico para empresas que quieren digitalizar procesos, fortalecer su presencia digital y operar con mayor eficiencia."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tudominio.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Jorge Veliz | Consultor Tecnológico y Desarrollador Full Stack</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#inicio" aria-label="Ir al inicio">
        <span class="brand-mark">JV</span>
        <span>Jorge Veliz</span>
      </a>
      <nav class="nav" aria-label="Navegación principal">
        <a href="#sobre-mi">Sobre mí</a>
        <a href="#servicios">Servicios</a>
        <a href="#industrias">Industrias</a>
        <a href="#portafolio">Portafolio</a>
        <a href="#blog">Blog</a>
        <a class="nav-cta" href="#contacto">Conversar</a>
      </nav>
    </header>

    <main id="inicio">
      <section class="hero section">
        <div class="hero-content">
          <p class="eyebrow">Consultoría tecnológica · Digitalización · Full Stack</p>
          <h1>Tu aliado tecnológico para digitalizar procesos y hacer crecer tu empresa.</h1>
          <p class="hero-copy">
            Soy Jorge Veliz, desarrollador Full Stack y consultor tecnológico. Ayudo a empresas a
            transformar operaciones manuales en sistemas digitales, fortalecer su presencia en línea y
            contar con una infraestructura confiable que respalde su crecimiento.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="#contacto">Conversar sobre tu proyecto</a>
            <a class="button secondary" href="#portafolio">Ver experiencia</a>
          </div>
          <div class="trust-bar" aria-label="Especialidades principales">
            <span>Laravel</span>
            <span>WordPress</span>
            <span>React</span>
            <span>Next.js</span>
            <span>VPS Linux</span>
          </div>
        </div>
        <aside class="hero-card" aria-label="Propuesta de valor">
          <div class="status-pill">Disponible para nuevos proyectos</div>
          <h2>Tecnología al servicio de tu operación, no al revés.</h2>
          <p>
            Trabajo con empresas que necesitan más que un sitio web: necesitan orden, eficiencia y un
            socio que entienda tanto el negocio como la parte técnica.
          </p>
          <div class="metric-grid">
            <div>
              <strong>Procesos</strong>
              <span>digitalización con sentido</span>
            </div>
            <div>
              <strong>Presencia</strong>
              <span>digital que genera confianza</span>
            </div>
            <div>
              <strong>Operación</strong>
              <span>estable y bajo control</span>
            </div>
          </div>
        </aside>
      </section>

      <section class="section logos" aria-label="Propuesta de valor">
        <span>Digitalización de procesos</span>
        <span>Presencia digital sólida</span>
        <span>Operaciones optimizadas</span>
        <span>Infraestructura confiable</span>
        <span>Acompañamiento consultivo</span>
      </section>

      <section id="sobre-mi" class="section split">
        <div>
          <p class="eyebrow">Sobre mí</p>
          <h2>Experiencia técnica con enfoque en lo que importa al negocio.</h2>
        </div>
        <div class="rich-text">
          <p>
            Soy Jorge Veliz, desarrollador Full Stack y consultor tecnológico con experiencia en
            clínicas, laboratorios, instituciones educativas, firmas de abogados, empresas de
            servicios y comercio electrónico.
          </p>
          <p>
            Mi trabajo no se limita a escribir código. Primero entiendo cómo opera tu empresa, qué
            procesos pueden mejorarse y qué solución digital tiene sentido para tu contexto. Luego
            construyo sistemas, sitios web e infraestructura con PHP, Laravel, WordPress, JavaScript,
            React, Next.js y servidores VPS Linux — siempre con una mirada práctica orientada a
            resultados.
          </p>
        </div>
      </section>

      <section id="servicios" class="section">
        <div class="section-heading">
          <p class="eyebrow">Servicios</p>
          <h2>Servicios pensados para resolver problemas reales de operación y crecimiento.</h2>
          <p>
            Cada servicio parte de una necesidad concreta del negocio: menos trabajo manual, mejor
            comunicación con clientes, más control sobre la operación o una base digital en la que
            puedas confiar.
          </p>
        </div>
        <div class="card-grid">
          {services.map((service) => (
            <article class="service-card">
              <h3>{service.title}</h3>
              <p>{service.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="industrias" class="section">
        <div class="section-heading">
          <p class="eyebrow">Industrias</p>
          <h2>Sectores donde he acompañado a empresas en su transformación digital.</h2>
          <p>
            Conozco las dinámicas, exigencias y oportunidades de distintos rubros. Eso me permite
            proponer soluciones que encajan con la realidad de cada sector, no con plantillas genéricas.
          </p>
        </div>
        <div class="card-grid">
          {industries.map((industry) => (
            <article class="service-card">
              <h3>{industry.title}</h3>
              <p>{industry.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="portafolio" class="section dark-section">
        <div class="section-heading">
          <p class="eyebrow">Portafolio</p>
          <h2>Tipos de proyectos en los que he participado.</h2>
          <p>
            Estos son ejemplos representativos del tipo de trabajo que realizo. Cada proyecto parte
            de un problema concreto del negocio y busca un resultado claro para quien lo contrata.
          </p>
        </div>
        <div class="project-grid">
          {projects.map((project) => (
            <article class="project-card">
              <span>{project.category}</span>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <strong>{project.result}</strong>
            </article>
          ))}
        </div>
      </section>

      <section id="tecnologias" class="section split">
        <div>
          <p class="eyebrow">Tecnologías</p>
          <h2>Herramientas que uso para construir soluciones sólidas y sostenibles.</h2>
        </div>
        <div>
          <p class="section-copy">
            Elijo la tecnología según lo que tu proyecto necesita, no al revés. La prioridad siempre
            es que la solución funcione bien hoy y pueda mantenerse y crecer mañana sin complicaciones
            innecesarias.
          </p>
          <div class="tech-list">
            {technologies.map((tech) => <span>{tech}</span>)}
          </div>
        </div>
      </section>

      <section id="blog" class="section">
        <div class="section-heading">
          <p class="eyebrow">Blog</p>
          <h2>Ideas y reflexiones sobre tecnología aplicada al negocio.</h2>
          <p>
            Contenido orientado a dueños y responsables de operaciones que quieren entender cuándo y
            cómo invertir en digitalización con criterio.
          </p>
        </div>
        <div class="blog-grid">
          {posts.map((post) => (
            <article class="blog-card">
              <p>Tema de interés</p>
              <h3>{post}</h3>
              <a href="#contacto">Hablemos de esto</a>
            </article>
          ))}
        </div>
      </section>

      <section class="section cta-panel">
        <div>
          <p class="eyebrow">Próximo paso</p>
          <h2>¿Tu empresa necesita ordenar procesos, mejorar su presencia digital o contar con una infraestructura confiable?</h2>
        </div>
        <a class="button primary" href="#contacto">Agendar una conversación</a>
      </section>

      <section id="contacto" class="section contact">
        <div>
          <p class="eyebrow">Contacto</p>
          <h2>Cuéntame qué necesita tu empresa y veamos cómo puedo ayudarte.</h2>
          <p>
            Escríbeme con una descripción breve de tu situación o proyecto. Te responderé con
            claridad sobre alcance, enfoque recomendado y los siguientes pasos a seguir.
          </p>
          <ul class="contact-points">
            <li>Entendimiento inicial de tu necesidad y contexto operativo.</li>
            <li>Propuesta de solución alineada con tus prioridades de negocio.</li>
            <li>Estimación transparente según alcance, plazos y complejidad.</li>
          </ul>
        </div>
        <form class="contact-form" name="contacto" method="post">
          <label>
            Nombre
            <input type="text" name="nombre" placeholder="Tu nombre" required />
          </label>
          <label>
            Email
            <input type="email" name="email" placeholder="tu@email.com" required />
          </label>
          <label>
            Tipo de proyecto
            <select name="tipo" required>
              <option value="">Selecciona una opción</option>
              <option>Digitalización de procesos</option>
              <option>Sistema empresarial a medida</option>
              <option>Sitio web corporativo</option>
              <option>WordPress / comercio electrónico</option>
              <option>Aplicación web (React / Next.js)</option>
              <option>Infraestructura / hosting / VPS</option>
              <option>Consultoría tecnológica</option>
            </select>
          </label>
          <label>
            Mensaje
            <textarea name="mensaje" rows="5" placeholder="Describe brevemente qué necesitas resolver o mejorar" required></textarea>
          </label>
          <button class="button primary" type="submit">Enviar mensaje</button>
          <p class="form-note">Responderé a tu solicitud en un plazo razonable.</p>
        </form>
      </section>
    </main>

    <footer class="footer">
      <p>© 2026 Jorge Veliz. Consultoría tecnológica, desarrollo Full Stack e infraestructura digital.</p>
      <a href="#inicio">Volver arriba</a>
    </footer>
  </body>
</html>

<style>
  :root {
    --bg: #f6f8fb;
    --surface: #ffffff;
    --ink: #0f172a;
    --muted: #5b6475;
    --line: #dce3ee;
    --primary: #2563eb;
    --primary-dark: #1744a7;
    --accent: #14b8a6;
    --dark: #08111f;
    --dark-soft: #111c2e;
    --radius: 24px;
    --shadow: 0 24px 80px rgba(15, 23, 42, 0.12);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background:
      radial-gradient(circle at top left, rgba(37, 99, 235, 0.12), transparent 34rem),
      linear-gradient(180deg, #ffffff 0%, var(--bg) 45%, #ffffff 100%);
    color: var(--ink);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    line-height: 1.6;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(1180px, calc(100% - 32px));
    margin: 16px auto 0;
    padding: 14px 16px;
    border: 1px solid rgba(220, 227, 238, 0.88);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.84);
    box-shadow: 0 16px 60px rgba(15, 23, 42, 0.08);
    backdrop-filter: blur(18px);
  }

  .brand,
  .nav,
  .hero-actions,
  .trust-bar,
  .logos,
  .cta-panel,
  .footer {
    display: flex;
    align-items: center;
  }

  .brand {
    gap: 0.7rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .brand-mark {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border-radius: 50%;
    background: var(--ink);
    color: #ffffff;
    font-size: 0.85rem;
  }

  .nav {
    gap: 1.2rem;
    color: var(--muted);
    font-size: 0.94rem;
    font-weight: 650;
  }

  .nav a:hover {
    color: var(--primary);
  }

  .nav-cta {
    padding: 0.75rem 1rem;
    border-radius: 999px;
    background: var(--ink);
    color: #ffffff !important;
  }

  .section {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 92px 0;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
    gap: 2rem;
    align-items: center;
    min-height: 760px;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--primary);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 820px;
    margin-bottom: 1.4rem;
    font-size: clamp(2.9rem, 7vw, 5.9rem);
    line-height: 0.95;
    letter-spacing: -0.07em;
  }

  h2 {
    margin-bottom: 1rem;
    font-size: clamp(2rem, 4vw, 3.45rem);
    line-height: 1.02;
    letter-spacing: -0.055em;
  }

  h3 {
    margin-bottom: 0.8rem;
    font-size: 1.18rem;
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .hero-copy,
  .section-heading p,
  .section-copy,
  .rich-text,
  .contact p {
    color: var(--muted);
    font-size: 1.08rem;
  }

  .hero-copy {
    max-width: 700px;
    margin-bottom: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.9rem 1.25rem;
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      background 180ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button.primary {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: #ffffff;
    box-shadow: 0 18px 40px rgba(37, 99, 235, 0.28);
  }

  .button.secondary {
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
  }

  .hero-actions {
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 2rem;
  }

  .trust-bar {
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .trust-bar span,
  .tech-list span,
  .logos span {
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.76);
    color: var(--muted);
    font-size: 0.88rem;
    font-weight: 750;
  }

  .trust-bar span {
    padding: 0.52rem 0.85rem;
  }

  .hero-card {
    position: relative;
    overflow: hidden;
    padding: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius);
    background:
      linear-gradient(145deg, rgba(20, 184, 166, 0.2), transparent 36%),
      linear-gradient(160deg, var(--dark), var(--dark-soft));
    color: #ffffff;
    box-shadow: var(--shadow);
  }

  .hero-card::after {
    position: absolute;
    right: -90px;
    bottom: -120px;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: rgba(37, 99, 235, 0.42);
    content: '';
    filter: blur(8px);
  }

  .hero-card h2 {
    position: relative;
    z-index: 1;
    font-size: clamp(1.7rem, 3vw, 2.55rem);
  }

  .hero-card p,
  .metric-grid span {
    position: relative;
    z-index: 1;
    color: #b9c3d6;
  }

  .status-pill {
    position: relative;
    z-index: 1;
    display: inline-flex;
    margin-bottom: 4rem;
    padding: 0.55rem 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: #dbeafe;
    font-size: 0.82rem;
    font-weight: 800;
  }

  .metric-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .metric-grid div {
    padding: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.06);
  }

  .metric-grid strong {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 1.45rem;
  }

  .logos {
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0 0 54px;
  }

  .logos span {
    flex: 1;
    padding: 1rem;
    text-align: center;
  }

  .split {
    display: grid;
    grid-template-columns: 0.78fr 1.22fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .rich-text p:last-child,
  .section-heading p:last-child,
  .section-copy:last-child {
    margin-bottom: 0;
  }

  .section-heading {
    max-width: 760px;
    margin-bottom: 2rem;
  }

  .card-grid,
  .project-grid,
  .blog-grid {
    display: grid;
    gap: 1rem;
  }

  .card-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .service-card,
  .blog-card,
  .contact-form {
