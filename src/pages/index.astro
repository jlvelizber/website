---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Jorge Veliz — Desarrollador Full Stack y consultor tecnológico. Aliado digital para empresas que buscan digitalizar procesos, mejorar su presencia web y optimizar operaciones."
    />
    <meta
      name="keywords"
      content="Jorge Veliz, consultor tecnológico, desarrollador full stack, digitalización empresarial, Laravel, WordPress, React, Next.js, VPS Linux"
    />
    <meta name="author" content="Jorge Veliz" />
    <meta property="og:title" content="Jorge Veliz | Consultor Tecnológico y Desarrollador Full Stack" />
    <meta
      property="og:description"
      content="Aliado tecnológico para empresas que quieren digitalizar procesos, fortalecer su presencia digital y operar con mayor eficiencia."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tudominio.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>Jorge Veliz | Consultor Tecnológico y Desarrollador Full Stack</title>
  </head>
  <body>
    <!-- 1. Header: logo | nav | CTA -->
    <header class="site-header">
      <div class="container header-row">
        <a class="brand" href="#inicio" aria-label="Ir al inicio">
          <!-- <span class="brand-mark">JV</span>
          <span class="brand-text">
            <strong>Jorge Veliz</strong>
            <small>Consultor tecnológico</small>
          </span> -->
          <img src="/images/logo-jorge-veliz.png" alt="Jorge Veliz" width="55%" />
          <!-- <span class="brand-text">
            <strong>Jorge Veliz</strong>
            <small>Consultor tecnológico</small>
          </span>  -->
        </a>
        <nav class="nav" aria-label="Navegación principal">
          <a href="#inicio">Inicio</a>
          <a href="#sobre-mi">Sobre mí</a>
          <a href="#servicios">Servicios</a>
          <a href="#portafolio">Portafolio</a>
          <!-- <a href="#blog">Blog</a> -->
          <a href="#contacto">Contacto</a>
        </nav>
        <a class="button dark" href="#contacto">Conversar</a>
      </div>
    </header>

    <main id="inicio">
      <!-- 2. Hero: copy izquierda + retrato derecha -->
      <section class="hero">
        <div class="container hero-row">
          <div class="hero-copy">
            <p class="welcome">Bienvenido a mi portafolio</p>
            <h1>
              Soy Jorge Veliz
              <span class="role">Full Stack &amp; consultor</span>
            </h1>
            <p class="lead">
              Más de 10 años creando sistemas a medida — banca, gobierno y salud — para digitalizar
              tu operación con claridad, seguridad y resultados.
            </p>
            <div class="hero-cta">
              <a class="button primary" href="#contacto">Hablemos</a>
              <div class="hero-note">
                <span>Enfoque</span>
                <strong>Digitalización empresarial</strong>
              </div>
            </div>
          </div>
          <div class="hero-visual">
            <div class="hero-orb" aria-hidden="true"></div>
            <figure class="hero-photo">
              <img
                src="/images/hero-jorge-veliz.jpg"
                alt="Jorge Veliz — consultor tecnológico"
                width="800"
                height="800"
                loading="eager"
              />
            </figure>
          </div>
        </div>
        <div class="container head-links">
          <a href="#contacto">Escríbeme para una consulta</a>
          <a href="#portafolio">Ver proyectos representativos</a>
        </div>
      </section>

      <!-- 3. About: bio + tarjetas de datos -->
      <section id="sobre-mi" class="section about">
        <div class="container about-row">
          <div class="about-copy">
            <h2>Sobre mí</h2>
            <p>
              Soy desarrollador Full Stack y consultor tecnológico con más de 10 años construyendo
              plataformas empresariales: banca digital, sistemas de gobierno, seguros y SaaS en salud.
              Ayudo a empresas a digitalizar procesos y lanzar sistemas a medida con claridad y seguridad.
            </p>
            <div class="tech-pills">
              {technologies.slice(0, 6).map((tech) => <span>{tech}</span>)}
            </div>
          </div>
          <aside class="about-cards">
            <div class="info-card">
              <div>
                <span>Nombre</span>
                <strong>Jorge Veliz</strong>
              </div>
            </div>
            <div class="info-card">
              <div>
                <span>Enfoque</span>
                <strong>Consultoría tecnológica</strong>
              </div>
            </div>
            <div class="info-card">
              <div>
                <span>LinkedIn</span>
                <strong>
                  <a
                    class="social-link"
                    href="https://www.linkedin.com/in/jlveliz/"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <svg
                      class="social-icon"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                      />
                    </svg>
                    /in/jlveliz
                  </a>
                </strong>
              </div>
            </div>
          </aside>
        </div>
      </section>

      <!-- 4. Services: heading centrado + grid -->
      <section id="servicios" class="section services">
        <div class="container">
          <div class="section-head center">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span> Servicios</p>
            <h2>Servicios esenciales</h2>
          </div>
          <div class="service-grid">
            {services.map((service) => (
              <article class="service-card">
                <span class="service-icon" set:html={serviceIcons[service.icon]} />
                <h3>{service.title}</h3>
                <p>{service.text}</p>
                <a href="#contacto">Consultar</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- 5. Portfolio: filtros + proyectos -->
      <section id="portafolio" class="section portfolio">
        <div class="container">
          <div class="section-head center">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span> Portafolio</p>
            <h2>Casos y proyectos</h2>
          </div>
          <div class="filters" role="tablist" aria-label="Filtrar proyectos">
            {filters.map((filter, index) => (
              <button
                type="button"
                class:list={['filter-btn', { active: index === 0 }]}
                data-filter={filter.id}
              >
                {filter.label}
              </button>
            ))}
          </div>
          <div class="project-grid">
            {projects.map((project) => (
              <article class="project-card" data-category={project.filter}>
                <img
                  src={project.image}
                  alt={project.title}
                  width="800"
                  height="500"
                  loading="lazy"
                />
                <div class="project-body">
                  <span>{project.category}</span>
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                  <strong>{project.result}</strong>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- 6. Industrias (bloque propio, no testimonios inventados) -->
      <section id="industrias" class="section industries">
        <div class="container">
          <div class="section-head center">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span> Industrias</p>
            <h2>Sectores donde he acompañado empresas</h2>
          </div>
          <div class="industry-grid">
            {industries.map((industry) => (
              <article class="industry-card">
                <span class="industry-icon" set:html={industryIcons[industry.icon]} />
                <h3>{industry.title}</h3>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- 7. Contact CTA: info + form -->
      <section id="contacto" class="section contact">
        <div class="container contact-row">
          <div class="contact-info">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span> Contacto</p>
            <h2>¿Tienes un proyecto en mente?</h2>
            <p>
              Cuéntame qué necesitas: un sistema a medida, digitalizar procesos o una presencia web
              sólida. Te respondo con alcance claro y próximos pasos.
            </p>
            <ul class="contact-list">
              <li><strong>Enfoque:</strong> Sistemas empresariales, SaaS y digitalización</li>
              <li><strong>Experiencia:</strong> Banca, gobierno, salud y SaaS</li>
              <li><strong>Respuesta:</strong> Con alcance y próximos pasos claros</li>
            </ul>
          </div>
          <form class="contact-form" name="contacto" method="post">
            <label>
              Nombre
              <input type="text" name="nombre" placeholder="Tu nombre" required />
            </label>
            <label>
              Email
              <input type="email" name="email" placeholder="tu@email.com" required />
            </label>
            <label>
              Tipo de proyecto
              <select name="tipo" required>
                <option value="">Selecciona una opción</option>
                <option>Digitalización de procesos</option>
                <option>Sistema empresarial a medida</option>
                <option>Sitio web corporativo</option>
                <option>WordPress / comercio electrónico</option>
                <option>Aplicación web (React / Next.js)</option>
                <option>Infraestructura / hosting / VPS</option>
                <option>Consultoría tecnológica</option>
              </select>
            </label>
            <label>
              Mensaje
              <textarea
                name="mensaje"
                rows="4"
                placeholder="Describe brevemente qué necesitas resolver"
                required
              ></textarea>
            </label>
            <button class="button primary" type="submit">Enviar solicitud</button>
          </form>
        </div>
      </section>

      <!-- 8. Blog -->
      <!-- <section id="blog" class="section blog">
        <div class="container">
          <div class="section-head center">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span> Blog</p>
            <h2>Ideas y reflexiones</h2>
          </div>
          <div class="blog-grid">
            {posts.map((post) => (
              <article class="blog-card">
                <img src={post.image} alt="" width="600" height="340" loading="lazy" />
                <div class="blog-body">
                  <span>{post.tag}</span>
                  <h3>{post.title}</h3>
                  <a href="#contacto">Hablemos de esto</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section> -->

      <!-- 9. Footer chat banner -->
      <section class="chat-banner">
        <div class="container chat-row">
          <div>
            <h2>¿Conversamos?</h2>
            <p>
              Si tienes un proyecto o quieres explorar cómo digitalizar procesos en tu empresa,
              escríbeme.
            </p>
          </div>
          <a class="button primary" href="#contacto">Ir a contacto</a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer-row">
        <p>© 2026 Jorge Veliz. Consultoría tecnológica · Full Stack · Infraestructura</p>
        <a class="back-top" href="#inicio" aria-label="Volver arriba" title="Volver arriba">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 19V5" />
            <path d="m5 12 7-7 7 7" />
          </svg>
        </a>
      </div>
    </footer>

    <script>
      const buttons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.project-card');

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');
          buttons.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          cards.forEach((card) => {
            const cat = card.getAttribute('data-category');
            card.hidden = !(filter === 'all' || cat === filter);
          });
        });
      });
    </script>
  </body>
</html>

<style>
  /* Paleta original del sitio (no Iteck) */
  :root {
    --bg: #f6f8fb;
    --surface: #ffffff;
    --ink: #0f172a;
    --muted: #5b6475;
    --line: #dce3ee;
    --primary: #2563eb;
    --primary-dark: #1744a7;
    --accent: #14b8a6;
    --dark: #08111f;
    --radius: 20px;
    --shadow: 0 16px 50px rgba(15, 23, 42, 0.08);
    --font: 'Plus Jakarta Sans', ui-sans-serif, system-ui, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    color: var(--ink);
    background: var(--bg);
    font-family: var(--font);
    line-height: 1.65;
  }

  img {
    display: block;
    max-width: 100%;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2,
  h3 {
    letter-spacing: -0.03em;
    line-height: 1.12;
    font-weight: 800;
